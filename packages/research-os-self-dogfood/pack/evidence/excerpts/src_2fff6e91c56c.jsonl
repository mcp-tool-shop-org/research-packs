{"excerpt_id":"ex_2fff6e91c56c_043","source_id":"src_2fff6e91c56c","source_hash":"d382603dd0dc5a1c0f5de3e122e4aa14c1704e287f3a4b936bf4ff40dbb6c1d3","text":"Both individuals and organizations that work with arXivLabs have embraced and accepted our values of openness, community, excellence, and user data privacy. arXiv is committed to these values and only works with partners that adhere to them.","location_hint":"paragraph 102","char_start":5683,"char_end":5924,"origin":"raw_text","created_at":"2026-05-07T18:37:43.323Z"}
