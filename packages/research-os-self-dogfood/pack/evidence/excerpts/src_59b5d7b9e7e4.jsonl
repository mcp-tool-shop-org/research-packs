{"excerpt_id":"ex_59b5d7b9e7e4_044","source_id":"src_59b5d7b9e7e4","source_hash":"c0c08dd9a23779a8c1867be90191f3e039c1c61d70d7a9c372b9f812cb940b11","text":"Both individuals and organizations that work with arXivLabs have embraced and accepted our values of openness, community, excellence, and user data privacy. arXiv is committed to these values and only works with partners that adhere to them.","location_hint":"paragraph 106","char_start":5615,"char_end":5856,"origin":"raw_text","created_at":"2026-05-07T18:38:18.267Z"}
