{"excerpt_id":"ex_d5da902c1965_001","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":".. _doc_cross_language_scripting:","location_hint":"paragraph 1","char_start":0,"char_end":33,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_002","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Cross-language scripting\n========================","location_hint":"paragraph 2","char_start":35,"char_end":84,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_003","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Godot allows you to mix and match scripting languages to suit your needs.\nThis means a single project can define nodes in both C# and GDScript.\nThis page will go through the possible interactions between two nodes written\nin different languages.","location_hint":"paragraph 3","char_start":86,"char_end":331,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_004","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"The following two scripts will be used as references throughout this page.","location_hint":"paragraph 4","char_start":333,"char_end":407,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_005","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":".. code-tab:: gdscript GDScript","location_hint":"paragraph 6","char_start":421,"char_end":452,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_006","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"var my_property: String = \"my gdscript value\":\n get:\n return my_property\n set(value):\n my_property = value","location_hint":"paragraph 8","char_start":470,"char_end":576,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_007","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"signal my_signal\n signal my_signal_with_params(msg: String, n: int)","location_hint":"paragraph 9","char_start":579,"char_end":646,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_008","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"func print_node_name(node: Node) -> void:\n print(node.get_name())","location_hint":"paragraph 10","char_start":649,"char_end":714,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_009","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"func print_array(arr: Array) -> void:\n for element in arr:\n print(element)","location_hint":"paragraph 11","char_start":717,"char_end":791,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_010","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"func print_n_times(msg: String, n: int) -> void:\n for i in range(n):\n print(msg)","location_hint":"paragraph 12","char_start":794,"char_end":874,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_011","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"func my_signal_handler():\n print(\"The signal handler was called!\")","location_hint":"paragraph 13","char_start":877,"char_end":943,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_012","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"func my_signal_with_params_handler(msg: String, n: int):\n print_n_times(msg, n)","location_hint":"paragraph 14","char_start":946,"char_end":1025,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_013","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public partial class MyCSharpNode : Node\n {\n public string MyProperty { get; set; } = \"my c# value\";","location_hint":"paragraph 17","char_start":1066,"char_end":1166,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_014","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"[Signal] public delegate void MySignalEventHandler();\n [Signal] public delegate void MySignalWithParamsEventHandler(string msg, int n);","location_hint":"paragraph 18","char_start":1169,"char_end":1304,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_015","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public void PrintNodeName(Node node)\n {\n GD.Print(node.Name);\n }","location_hint":"paragraph 19","char_start":1307,"char_end":1371,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_016","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public void PrintArray(string[] arr)\n {\n foreach (string element in arr)\n {\n GD.Print(element);\n }\n }","location_hint":"paragraph 20","char_start":1374,"char_end":1475,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_017","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public void PrintNTimes(string msg, int n)\n {\n for (int i = 0; i < n; ++i)\n {\n GD.Print(msg);\n }\n }","location_hint":"paragraph 21","char_start":1478,"char_end":1577,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_018","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public void MySignalHandler()\n {\n GD.Print(\"The signal handler was called!\");\n }","location_hint":"paragraph 22","char_start":1580,"char_end":1660,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_019","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"public void MySignalWithParamsHandler(string msg, int n)\n {\n PrintNTimes(msg, n);\n }\n }","location_hint":"paragraph 23","char_start":1663,"char_end":1750,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_020","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Instantiating nodes\n-------------------","location_hint":"paragraph 24","char_start":1752,"char_end":1791,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_021","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"If you're not using nodes from the scene tree, you'll probably want to\ninstantiate nodes directly from the code.","location_hint":"paragraph 25","char_start":1793,"char_end":1905,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_022","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Instantiating C# nodes from GDScript\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 26","char_start":1907,"char_end":1980,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_023","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Using C# from GDScript doesn't need much work. Once loaded\n(see :ref:`doc_gdscript_classes_as_resources`), the script can be instantiated\nwith :ref:`new() <class_CSharpScript_method_new>`.","location_hint":"paragraph 27","char_start":1982,"char_end":2170,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_024","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"var MyCSharpScript = load(\"res://Path/To/MyCSharpNode.cs\")\n var my_csharp_node = MyCSharpScript.new()","location_hint":"paragraph 29","char_start":2199,"char_end":2300,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_025","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"When creating ``.cs`` scripts, you should always keep in mind that the class\n Godot will use is the one named like the ``.cs`` file itself. If that class\n does not exist in the file, you'll see the following error:\n ``Invalid call. Nonexistent function `new` in base``.","location_hint":"paragraph 31","char_start":2317,"char_end":2586,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_026","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"For example, MyCoolNode.cs should contain a class named MyCoolNode.","location_hint":"paragraph 32","char_start":2589,"char_end":2656,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_027","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"The C# class needs to derive a Godot class, for example ``GodotObject``.\n Otherwise, the same error will occur.","location_hint":"paragraph 33","char_start":2659,"char_end":2770,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_028","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"You also need to check your ``.cs`` file is referenced in the project's\n ``.csproj`` file. Otherwise, the same error will occur.","location_hint":"paragraph 34","char_start":2773,"char_end":2901,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_029","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Instantiating GDScript nodes from C#\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 35","char_start":2903,"char_end":2976,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_030","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"From the C# side, everything work the same way. Once loaded, the GDScript can\nbe instantiated with :ref:`GDScript.New() <class_GDScript_method_new>`.","location_hint":"paragraph 36","char_start":2978,"char_end":3127,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_031","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"var myGDScript = GD.Load<GDScript>(\"res://path/to/my_gd_script.gd\");\n var myGDScriptNode = (GodotObject)myGDScript.New(); // This is a GodotObject.","location_hint":"paragraph 38","char_start":3154,"char_end":3301,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_032","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Here we are using an :ref:`class_Object`, but you can use type conversion like\nexplained in :ref:`doc_c_sharp_features_type_conversion_and_casting`.","location_hint":"paragraph 39","char_start":3303,"char_end":3451,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_033","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Accessing fields\n----------------","location_hint":"paragraph 40","char_start":3453,"char_end":3486,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_034","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Accessing C# fields from GDScript\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 41","char_start":3488,"char_end":3555,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_035","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Accessing C# fields from GDScript is straightforward, you shouldn't have\nanything to worry about.","location_hint":"paragraph 42","char_start":3557,"char_end":3654,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_036","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"# Output: \"my c# value\".\n print(my_csharp_node.MyProperty)\n my_csharp_node.MyProperty = \"MY C# VALUE\"\n # Output: \"MY C# VALUE\".\n print(my_csharp_node.MyProperty)","location_hint":"paragraph 44","char_start":3683,"char_end":3844,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_037","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Accessing GDScript fields from C#\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 45","char_start":3846,"char_end":3913,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_038","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"As C# is statically typed, accessing GDScript from C# is a bit more\nconvoluted. You will have to use :ref:`GodotObject.Get() <class_Object_method_get>`\nand :ref:`GodotObject.Set() <class_Object_method_set>`. The first argument is the name of the field you want to access.","location_hint":"paragraph 46","char_start":3915,"char_end":4186,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_039","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"// Output: \"my gdscript value\".\n GD.Print(myGDScriptNode.Get(\"my_property\"));\n myGDScriptNode.Set(\"my_property\", \"MY GDSCRIPT VALUE\");\n // Output: \"MY GDSCRIPT VALUE\".\n GD.Print(myGDScriptNode.Get(\"my_property\"));","location_hint":"paragraph 48","char_start":4213,"char_end":4426,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_040","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Keep in mind that when setting a field value you should only use types the\nGDScript side knows about.\nEssentially, you want to work with built-in types as described in\n:ref:`doc_gdscript_builtin_types` or classes extending :ref:`class_Object`.","location_hint":"paragraph 49","char_start":4428,"char_end":4671,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_041","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Calling methods\n---------------","location_hint":"paragraph 50","char_start":4673,"char_end":4704,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_042","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Calling C# methods from GDScript\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 51","char_start":4706,"char_end":4771,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_043","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Again, calling C# methods from GDScript should be straightforward. The\nmarshalling process will do its best to cast the arguments to match\nfunction signatures.\nIf that's impossible, you'll see the following error: ``Invalid call. Nonexistent function `FunctionName```.","location_hint":"paragraph 52","char_start":4773,"char_end":5041,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_044","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"# Output: \"my_gd_script_node\" (or name of node where this code is placed).\n my_csharp_node.PrintNodeName(self)\n # This line will fail.\n # my_csharp_node.PrintNodeName()","location_hint":"paragraph 54","char_start":5070,"char_end":5238,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_045","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"# Outputs \"Hello there!\" twice, once per line.\n my_csharp_node.PrintNTimes(\"Hello there!\", 2)","location_hint":"paragraph 55","char_start":5241,"char_end":5334,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_046","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"# Output: \"a\", \"b\", \"c\" (one per line).\n my_csharp_node.PrintArray([\"a\", \"b\", \"c\"])\n # Output: \"1\", \"2\", \"3\" (one per line).\n my_csharp_node.PrintArray([1, 2, 3])","location_hint":"paragraph 56","char_start":5337,"char_end":5499,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_047","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Calling GDScript methods from C#\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 57","char_start":5501,"char_end":5566,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_048","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"To call GDScript methods from C# you'll need to use\n:ref:`GodotObject.Call() <class_Object_method_call>`. The first argument is the\nname of the method you want to call. The following arguments will be passed\nto said method.","location_hint":"paragraph 58","char_start":5568,"char_end":5791,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_049","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"// Output: \"MyCSharpNode\" (or name of node where this code is placed).\n myGDScriptNode.Call(\"print_node_name\", this);\n // This line will fail silently and won't error out.\n // myGDScriptNode.Call(\"print_node_name\");","location_hint":"paragraph 60","char_start":5818,"char_end":6033,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_050","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"// Outputs \"Hello there!\" twice, once per line.\n myGDScriptNode.Call(\"print_n_times\", \"Hello there!\", 2);","location_hint":"paragraph 61","char_start":6036,"char_end":6141,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_051","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"string[] arr = [\"a\", \"b\", \"c\"];\n // Output: \"a\", \"b\", \"c\" (one per line).\n myGDScriptNode.Call(\"print_array\", arr);\n // Output: \"1\", \"2\", \"3\" (one per line).\n myGDScriptNode.Call(\"print_array\", new int[] { 1, 2, 3 });\n // Note how the type of each array entry does not matter\n // as long as it can be handled by the marshaller.","location_hint":"paragraph 62","char_start":6144,"char_end":6471,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
