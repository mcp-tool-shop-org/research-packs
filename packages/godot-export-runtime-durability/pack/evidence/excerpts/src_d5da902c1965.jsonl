{"excerpt_id":"ex_d5da902c1965_053","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Connecting to signals\n---------------------","location_hint":"paragraph 64","char_start":6516,"char_end":6559,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_054","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Connecting to C# signals from GDScript\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 65","char_start":6561,"char_end":6638,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_055","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Connecting to a C# signal from GDScript is the same as connecting to a signal\ndefined in GDScript:","location_hint":"paragraph 66","char_start":6640,"char_end":6738,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_056","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"my_csharp_node.MySignal.connect(my_signal_handler)","location_hint":"paragraph 68","char_start":6767,"char_end":6817,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_057","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"my_csharp_node.MySignalWithParams.connect(my_signal_with_params_handler)","location_hint":"paragraph 69","char_start":6820,"char_end":6892,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_058","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Connecting to GDScript signals from C#\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~","location_hint":"paragraph 70","char_start":6894,"char_end":6971,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_059","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"Connecting to a GDScript signal from C# only works with the ``Connect`` method\nbecause no C# static types exist for signals defined by GDScript:","location_hint":"paragraph 71","char_start":6973,"char_end":7117,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_060","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"myGDScriptNode.Connect(\"my_signal\", Callable.From(MySignalHandler));","location_hint":"paragraph 73","char_start":7144,"char_end":7212,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_061","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"myGDScriptNode.Connect(\"my_signal_with_params\", Callable.From<string, int>(MySignalWithParamsHandler));","location_hint":"paragraph 74","char_start":7215,"char_end":7318,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
{"excerpt_id":"ex_d5da902c1965_062","source_id":"src_d5da902c1965","source_hash":"e6a6c276002523a2794bf2e33bd081568a48b64386b5d5602e10dceed510f49a","text":"A GDScript file may not inherit from a C# script. Likewise, a C# script may not\ninherit from a GDScript file. Due to how complex this would be to implement,\nthis limitation is unlikely to be lifted in the future. See\n`this GitHub issue <https://github.com/godotengine/godot/issues/38352>`__\nfor more information.","location_hint":"paragraph 76","char_start":7345,"char_end":7657,"origin":"raw_text","created_at":"2026-05-10T07:02:35.377Z"}
