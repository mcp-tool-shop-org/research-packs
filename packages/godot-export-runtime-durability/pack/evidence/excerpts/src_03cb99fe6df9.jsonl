{"excerpt_id":"ex_03cb99fe6df9_069","source_id":"src_03cb99fe6df9","source_hash":"81b0f6b41fe9dca67089d3df19269758684e392a403eba858c295dec2dba05a4","text":"You can find a full list of export options available in the\n:ref:`class_EditorExportPlatformMacOS` class reference.","location_hint":"paragraph 63","char_start":21705,"char_end":21820,"origin":"raw_text","created_at":"2026-05-10T05:01:56.514Z"}
