{"excerpt_id":"ex_097142ab08d3_065","source_id":"src_097142ab08d3","source_hash":"7451d4268f8c681081bc1fd8c4ca0b13d203a57018b7e284d69de39fd7df94fb","text":"asfNoFreeze 6 Permanently give up the ability to freeze individual trust lines or disable Global Freeze . This flag can never be disabled after being enabled.","location_hint":"paragraph 283","char_start":11204,"char_end":11362,"origin":"raw_text","created_at":"2026-05-09T18:54:30.083Z"}
