{"excerpt_id":"ex_ec68826269c9_015","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"{\n\"id\" : 2 ,\n\"command\" : \"account_info\" ,\n\"account\" : \"rG1QQv2nh2gr7RCZ1P8YYcBUKCCN633jCn\" ,\n\"ledger_index\" : \"current\" ,\n\"queue\" : true\n}","location_hint":"paragraph 114","char_start":2707,"char_end":2845,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
