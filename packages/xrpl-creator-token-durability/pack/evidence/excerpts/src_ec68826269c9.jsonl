{"excerpt_id":"ex_ec68826269c9_017","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"Field Type Required? Description","location_hint":"paragraph 117","char_start":2906,"char_end":2938,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_018","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"account String - Address Yes The account to look up.","location_hint":"paragraph 118","char_start":2942,"char_end":2994,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_019","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"ledger_hash String No The unique hash of the ledger version to use. (See Specifying Ledgers )","location_hint":"paragraph 119","char_start":2996,"char_end":3089,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_020","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"ledger_index Number or String No The ledger index of the ledger to use, or a shortcut string to choose a ledger automatically. (See Specifying Ledgers )","location_hint":"paragraph 120","char_start":3091,"char_end":3243,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_021","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"queue Boolean No If true , return stats about queued transactions sent by this account. Can only be used when querying for the data from the current open ledger.","location_hint":"paragraph 121","char_start":3245,"char_end":3406,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_022","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"signer_lists Boolean No If true , return any SignerList objects associated with this account.","location_hint":"paragraph 122","char_start":3408,"char_end":3501,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
{"excerpt_id":"ex_ec68826269c9_023","source_id":"src_ec68826269c9","source_hash":"83e67b24d742b7042fd68bf0d926788f50ef89a0157a2b7ceec3ea29362d0b16","text":"The following fields are deprecated and should not be provided: ident , ledger , strict .","location_hint":"paragraph 123","char_start":3505,"char_end":3594,"origin":"raw_text","created_at":"2026-05-09T18:22:51.131Z"}
