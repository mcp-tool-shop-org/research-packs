{"excerpt_id":"ex_33402410a906_023","source_id":"src_33402410a906","source_hash":"7d871f7fbe6afb5f06c170471aa65e595dc83f8d2828972f573107348be0b08c","text":"The Flags value of the EnableAmendment pseudo-transaction indicates the status of the amendment at the time of the ledger including the pseudo-transaction.","location_hint":"paragraph 103","char_start":3231,"char_end":3386,"origin":"raw_text","created_at":"2026-05-09T21:11:38.125Z"}
