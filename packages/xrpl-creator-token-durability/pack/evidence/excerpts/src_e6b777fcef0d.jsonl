{"excerpt_id":"ex_e6b777fcef0d_013","source_id":"src_e6b777fcef0d","source_hash":"1bd42660ea0fca40a544af380ba3bdfe56f2690fdca040bb39d7a342b0bbad57","text":"The feature command returns information about amendments this server knows about, including whether they are enabled and if the server knows how to apply the amendments.","location_hint":"paragraph 102","char_start":2250,"char_end":2419,"origin":"raw_text","created_at":"2026-05-09T21:12:58.327Z"}
{"excerpt_id":"ex_e6b777fcef0d_014","source_id":"src_e6b777fcef0d","source_hash":"1bd42660ea0fca40a544af380ba3bdfe56f2690fdca040bb39d7a342b0bbad57","text":"This is the non-admin version of the feature admin command . It follows the same formatting as the admin command, but hides potentially sensitive data.","location_hint":"paragraph 103","char_start":2421,"char_end":2572,"origin":"raw_text","created_at":"2026-05-09T21:12:58.327Z"}
