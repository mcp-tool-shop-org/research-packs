{"excerpt_id":"ex_24fc488e7bd9_015","source_id":"src_24fc488e7bd9","source_hash":"b32965102970386b9e93b7c62d4505853d0288705e4e3ca31685a63943a4e4d7","text":"Assign, change, or remove the regular key pair associated with your account.","location_hint":"paragraph 227","char_start":4636,"char_end":4712,"origin":"raw_text","created_at":"2026-05-09T18:55:44.630Z"}
{"excerpt_id":"ex_24fc488e7bd9_016","source_id":"src_24fc488e7bd9","source_hash":"b32965102970386b9e93b7c62d4505853d0288705e4e3ca31685a63943a4e4d7","text":"You can protect your account by assigning a regular key pair to it and using it instead of the master key pair to sign transactions whenever possible. If your regular key pair is compromised, but your master key pair is not, you can use a SetRegularKey transaction to regain control of your account.","location_hint":"paragraph 228","char_start":4714,"char_end":5013,"origin":"raw_text","created_at":"2026-05-09T18:55:44.630Z"}
