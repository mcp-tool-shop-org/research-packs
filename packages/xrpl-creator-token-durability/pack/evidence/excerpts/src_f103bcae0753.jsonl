{"excerpt_id":"ex_f103bcae0753_019","source_id":"src_f103bcae0753","source_hash":"c1241d1114ee5df9b19a0f118c6385069aa84a8e13c671885d6cac6abe4e0f90","text":"nft_id String The unique identifier of a NFToken object.","location_hint":"paragraph 118","char_start":2994,"char_end":3050,"origin":"raw_text","created_at":"2026-05-09T20:25:24.441Z"}
{"excerpt_id":"ex_f103bcae0753_020","source_id":"src_f103bcae0753","source_hash":"c1241d1114ee5df9b19a0f118c6385069aa84a8e13c671885d6cac6abe4e0f90","text":"ledger_hash String (Optional) The unique hash of the ledger version to use. (See Specifying Ledgers )","location_hint":"paragraph 119","char_start":3052,"char_end":3153,"origin":"raw_text","created_at":"2026-05-09T20:25:24.441Z"}
{"excerpt_id":"ex_f103bcae0753_021","source_id":"src_f103bcae0753","source_hash":"c1241d1114ee5df9b19a0f118c6385069aa84a8e13c671885d6cac6abe4e0f90","text":"ledger_index String or Number (Optional) The ledger index of the ledger to use, or a shortcut string to choose a ledger automatically. (See Specifying Ledgers )","location_hint":"paragraph 120","char_start":3155,"char_end":3315,"origin":"raw_text","created_at":"2026-05-09T20:25:24.441Z"}
{"excerpt_id":"ex_f103bcae0753_022","source_id":"src_f103bcae0753","source_hash":"c1241d1114ee5df9b19a0f118c6385069aa84a8e13c671885d6cac6abe4e0f90","text":"limit Integer (Optional) Limit the number of NFT buy offers to retrieve. This value cannot be lower than 50 or more than 500. Positive values outside this range are replaced with the closest valid option. The default is 250.","location_hint":"paragraph 121","char_start":3317,"char_end":3541,"origin":"raw_text","created_at":"2026-05-09T20:25:24.441Z"}
