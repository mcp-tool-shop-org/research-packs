{"excerpt_id":"ex_051630391070_020","source_id":"src_051630391070","source_hash":"a544809d623db977d41eacddfcce89b73bcf192a2f936c2a50b0d327f1fc09c6","text":"Account String - Address AccountID Yes The account that owns this offer.","location_hint":"paragraph 148","char_start":4138,"char_end":4210,"origin":"raw_text","created_at":"2026-05-09T18:17:10.472Z"}
{"excerpt_id":"ex_051630391070_021","source_id":"src_051630391070","source_hash":"a544809d623db977d41eacddfcce89b73bcf192a2f936c2a50b0d327f1fc09c6","text":"AdditionalBooks Array Array No A list of additional offer directories that link to this offer. This field is only present if this is a hybrid offer in a permissioned DEX . The array always contains exactly 1 entry.","location_hint":"paragraph 149","char_start":4212,"char_end":4426,"origin":"raw_text","created_at":"2026-05-09T18:17:10.472Z"}
