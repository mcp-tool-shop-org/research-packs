{"excerpt_id":"ex_051630391070_023","source_id":"src_051630391070","source_hash":"a544809d623db977d41eacddfcce89b73bcf192a2f936c2a50b0d327f1fc09c6","text":"BookDirectory String - Hash UInt256 Yes The ID of the offer directory that links to this offer.","location_hint":"paragraph 151","char_start":4483,"char_end":4578,"origin":"raw_text","created_at":"2026-05-09T18:17:10.472Z"}
{"excerpt_id":"ex_051630391070_024","source_id":"src_051630391070","source_hash":"a544809d623db977d41eacddfcce89b73bcf192a2f936c2a50b0d327f1fc09c6","text":"BookNode String UInt64 Yes A hint indicating which page of the offer directory links to this entry, in case the directory consists of multiple pages.","location_hint":"paragraph 152","char_start":4580,"char_end":4729,"origin":"raw_text","created_at":"2026-05-09T18:17:10.472Z"}
