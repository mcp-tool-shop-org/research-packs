{"excerpt_id":"ex_9505395adfe8_030","source_id":"src_9505395adfe8","source_hash":"1053fd845d47dccfbc7e9acd815c62f9ff4cd1ab9094c995aaebaa72f01294c3","text":"MintedNFTokens Number UInt32 No How many total non-fungible tokens have been minted by and on behalf of this account.","location_hint":"paragraph 159","char_start":5467,"char_end":5584,"origin":"raw_text","created_at":"2026-05-09T18:18:13.791Z"}
{"excerpt_id":"ex_9505395adfe8_031","source_id":"src_9505395adfe8","source_hash":"1053fd845d47dccfbc7e9acd815c62f9ff4cd1ab9094c995aaebaa72f01294c3","text":"Requires the NonFungibleTokensV1_1 amendment . Loading...","location_hint":"paragraph 160","char_start":5586,"char_end":5643,"origin":"raw_text","created_at":"2026-05-09T18:18:13.791Z"}
