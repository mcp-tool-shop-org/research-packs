{"excerpt_id":"ex_9505395adfe8_085","source_id":"src_9505395adfe8","source_hash":"1053fd845d47dccfbc7e9acd815c62f9ff4cd1ab9094c995aaebaa72f01294c3","text":"lsfDisallowIncomingTrustline 0x20000000 536870912 asfDisallowIncomingTrustline This account blocks incoming trust lines.","location_hint":"paragraph 216","char_start":12837,"char_end":12957,"origin":"raw_text","created_at":"2026-05-09T18:18:13.791Z"}
