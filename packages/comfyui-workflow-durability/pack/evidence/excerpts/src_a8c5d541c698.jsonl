{"excerpt_id":"ex_a8c5d541c698_015","source_id":"src_a8c5d541c698","source_hash":"ee1e14bc82ad9ec2a763a7ed0bf487fe4802b73cc38069a27a1954b5b4d223af","text":"ComfyUI Desktop currently has no Linux prebuilds , please visit the Manual Installation section to install ComfyUI","location_hint":"paragraph 94","char_start":2982,"char_end":3096,"origin":"raw_text","created_at":"2026-05-09T05:23:53.303Z"}
{"excerpt_id":"ex_a8c5d541c698_016","source_id":"src_a8c5d541c698","source_hash":"ee1e14bc82ad9ec2a763a7ed0bf487fe4802b73cc38069a27a1954b5b4d223af","text":"Portable version is a ComfyUI version that integrates an independent embedded Python environment, using the portable version you can experience the latest features, currently only supports Windows system","location_hint":"paragraph 96","char_start":3132,"char_end":3335,"origin":"raw_text","created_at":"2026-05-09T05:23:53.303Z"}
{"excerpt_id":"ex_a8c5d541c698_017","source_id":"src_a8c5d541c698","source_hash":"ee1e14bc82ad9ec2a763a7ed0bf487fe4802b73cc38069a27a1954b5b4d223af","text":"ComfyUI Portable (Windows) Installation Guide","location_hint":"paragraph 97","char_start":3341,"char_end":3386,"origin":"raw_text","created_at":"2026-05-09T05:23:53.303Z"}
