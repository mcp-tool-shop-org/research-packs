{"excerpt_id":"ex_664a4a54b4c3_023","source_id":"src_664a4a54b4c3","source_hash":"c62e4571c3aeadb02f462f4f969b614956dc4d142c956e43ec12a7fcb6967a34","text":"Install Nightly version (might be more risky)","location_hint":"paragraph 107","char_start":3286,"char_end":3331,"origin":"raw_text","created_at":"2026-05-09T05:23:53.667Z"}
