{"excerpt_id":"ex_664a4a54b4c3_018","source_id":"src_664a4a54b4c3","source_hash":"c62e4571c3aeadb02f462f4f969b614956dc4d142c956e43ec12a7fcb6967a34","text":"If you have not installed Microsoft Visual C++ Redistributable, please install it here.","location_hint":"paragraph 94","char_start":2791,"char_end":2878,"origin":"raw_text","created_at":"2026-05-09T05:23:53.667Z"}
{"excerpt_id":"ex_664a4a54b4c3_019","source_id":"src_664a4a54b4c3","source_hash":"c62e4571c3aeadb02f462f4f969b614956dc4d142c956e43ec12a7fcb6967a34","text":"git clone git@github.com:comfyanonymous/ComfyUI.git","location_hint":"paragraph 97","char_start":2939,"char_end":2990,"origin":"raw_text","created_at":"2026-05-09T05:23:53.667Z"}
{"excerpt_id":"ex_664a4a54b4c3_020","source_id":"src_664a4a54b4c3","source_hash":"c62e4571c3aeadb02f462f4f969b614956dc4d142c956e43ec12a7fcb6967a34","text":"Install GPU and ComfyUI dependencies","location_hint":"paragraph 99","char_start":3000,"char_end":3036,"origin":"raw_text","created_at":"2026-05-09T05:23:53.667Z"}
{"excerpt_id":"ex_664a4a54b4c3_021","source_id":"src_664a4a54b4c3","source_hash":"c62e4571c3aeadb02f462f4f969b614956dc4d142c956e43ec12a7fcb6967a34","text":"conda install pytorch torchvision torchaudio pytorch-cuda=12.1 -c pytorch -c nvidia","location_hint":"paragraph 104","char_start":3113,"char_end":3196,"origin":"raw_text","created_at":"2026-05-09T05:23:53.667Z"}
