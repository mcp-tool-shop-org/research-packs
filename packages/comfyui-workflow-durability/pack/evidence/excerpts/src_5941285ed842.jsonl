{"excerpt_id":"ex_5941285ed842_031","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"failed Job encountered an error","location_hint":"paragraph 151","char_start":5755,"char_end":5786,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_032","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"cancelled Job was cancelled by user","location_hint":"paragraph 152","char_start":5788,"char_end":5823,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_033","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"# Poll for job completion\ncurl -X GET \" $BASE_URL /api/job/{prompt_id}/status\" \\\n-H \"X-API-Key: $COMFY_CLOUD_API_KEY \"","location_hint":"paragraph 156","char_start":5863,"char_end":5981,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_034","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"# Response examples:\n# {\"status\": \"pending\"} - Job is queued\n# {\"status\": \"in_progress\"} - Job is currently running\n# {\"status\": \"completed\"} - Job finished successfully\n# {\"status\": \"failed\"} - Job encountered an error\n# {\"status\": \"cancelled\"} - Job was cancelled","location_hint":"paragraph 157","char_start":5983,"char_end":6248,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_035","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"WebSocket for Real-Time Progress","location_hint":"paragraph 159","char_start":6260,"char_end":6292,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_036","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"Connect to the WebSocket for real-time execution updates.","location_hint":"paragraph 160","char_start":6294,"char_end":6351,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_037","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"The clientId parameter is currently ignored—all connections for a user receive the same messages. Pass a unique clientId for forward compatibility.","location_hint":"paragraph 161","char_start":6355,"char_end":6502,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_038","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"async function listenForCompletion (\npromptId : string ,\ntimeout : number = 300000\n) : Promise < Record < string , any >> {\nconst wsUrl = `wss://cloud.comfy.org/ws?clientId= ${ crypto . randomUUID () } &token= ${ API_KEY } ` ;\nconst outputs : Record < string , any > = {};","location_hint":"paragraph 164","char_start":6532,"char_end":6804,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_039","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"return new Promise (( resolve , reject ) => {\nconst ws = new WebSocket ( wsUrl );\nconst timer = setTimeout (() => {\nws . close ();\nreject ( new Error ( `Job did not complete within ${ timeout / 1000 } s` ));\n}, timeout );","location_hint":"paragraph 165","char_start":6806,"char_end":7027,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_040","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"ws . onmessage = ( event ) => {\nconst data = JSON . parse ( event . data );\nconst msgType = data . type ;\nconst msgData = data . data ?? {};","location_hint":"paragraph 166","char_start":7029,"char_end":7169,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_041","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"// Filter to our job\nif ( msgData . prompt_id !== promptId ) return ;","location_hint":"paragraph 167","char_start":7171,"char_end":7240,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_042","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"if ( msgType === \"executing\" ) {\nconst node = msgData . node ;\nif ( node ) {\nconsole . log ( `Executing node: ${ node } ` );\n} else {\nconsole . log ( \"Execution complete\" );\n}\n} else if ( msgType === \"progress\" ) {\nconsole . log ( `Progress: ${ msgData . value } / ${ msgData . max } ` );\n} else if ( msgType === \"executed\" && msgData . output ) {\noutputs [ msgData . node ] = msgData . output ;\n} else if ( msgType === \"execution_success\" ) {\nconsole . log ( \"Job completed successfully!\" );\nclearTimeout ( timer );\nws . close ();\nresolve ( outputs );\n} else if ( msgType === \"execution_error\" ) {\nconst errorMsg = msgData . exception_message ?? \"Unknown error\" ;\nclearTimeout ( timer );\nws . close ();\nreject ( new Error ( `Execution error: ${ errorMsg } ` ));\n}\n};","location_hint":"paragraph 168","char_start":7242,"char_end":8009,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_043","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"ws . onerror = ( err ) => {\nclearTimeout ( timer );\nreject ( err );\n};\n});\n}","location_hint":"paragraph 169","char_start":8011,"char_end":8087,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_044","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"// Wait for completion and collect outputs\nconst outputs = await listenForCompletion ( promptId );","location_hint":"paragraph 170","char_start":8089,"char_end":8187,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_045","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"Messages are sent as JSON text frames unless otherwise noted.","location_hint":"paragraph 173","char_start":8222,"char_end":8283,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
