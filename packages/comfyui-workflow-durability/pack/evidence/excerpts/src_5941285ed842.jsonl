{"excerpt_id":"ex_5941285ed842_014","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"Upload images, masks, or other files for use in workflows.","location_hint":"paragraph 105","char_start":2764,"char_end":2822,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
