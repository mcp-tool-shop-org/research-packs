{"excerpt_id":"ex_5941285ed842_016","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"The subfolder parameter is accepted for API compatibility but ignored in cloud storage. All files are stored in a flat, content-addressed namespace.","location_hint":"paragraph 114","char_start":3069,"char_end":3217,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
{"excerpt_id":"ex_5941285ed842_017","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"curl -X POST \" $BASE_URL /api/upload/mask\" \\\n-H \"X-API-Key: $COMFY_CLOUD_API_KEY \" \\\n-F \"image=@mask.png\" \\\n-F \"type=input\" \\\n-F \"subfolder=clipspace\" \\\n-F &#x27;original_ref={\"filename\":\"my_image.png\",\"subfolder\":\"\",\"type\":\"input\"}&#x27;","location_hint":"paragraph 118","char_start":3255,"char_end":3493,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
