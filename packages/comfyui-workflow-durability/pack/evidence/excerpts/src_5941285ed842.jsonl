{"excerpt_id":"ex_5941285ed842_009","source_id":"src_5941285ed842","source_hash":"08848f0378f52141326eacae87a103d6f7ad9e8485faba3a987892db2dc9eace","text":"Subscription Required: Running workflows via the API requires an active Comfy Cloud subscription. See pricing plans for details.","location_hint":"paragraph 88","char_start":2132,"char_end":2260,"origin":"raw_text","created_at":"2026-05-09T04:43:03.749Z"}
