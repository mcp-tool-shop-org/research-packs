{"excerpt_id":"ex_2ae04b870db8_015","source_id":"src_2ae04b870db8","source_hash":"b735bff7bd8358a4ef4aa1859a0c7035c48a77dda5aebddcde5cf4dc664dfabe","text":"We’re gathering feedback to prioritize improvements. The LiteGraph.js rendering system remains available, and you can toggle between systems at any time.","location_hint":"paragraph 85","char_start":2738,"char_end":2891,"origin":"raw_text","created_at":"2026-05-08T21:14:12.241Z"}
