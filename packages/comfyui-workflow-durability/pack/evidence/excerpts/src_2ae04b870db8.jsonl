{"excerpt_id":"ex_2ae04b870db8_012","source_id":"src_2ae04b870db8","source_hash":"b735bff7bd8358a4ef4aa1859a0c7035c48a77dda5aebddcde5cf4dc664dfabe","text":"Performance Still optimizing toward Canvas-level performance. Certain scenarios may behave differently.","location_hint":"paragraph 82","char_start":2456,"char_end":2559,"origin":"raw_text","created_at":"2026-05-08T21:14:12.241Z"}
{"excerpt_id":"ex_2ae04b870db8_013","source_id":"src_2ae04b870db8","source_hash":"b735bff7bd8358a4ef4aa1859a0c7035c48a77dda5aebddcde5cf4dc664dfabe","text":"Compatibility Some custom nodes may require updates to be fully supported.","location_hint":"paragraph 83","char_start":2561,"char_end":2635,"origin":"raw_text","created_at":"2026-05-08T21:14:12.241Z"}
