roz/following{/other_user}","gists_url":"https://api.github.com/users/AustinMroz/gists{/gist_id}","starred_url":"https://api.github.com/users/AustinMroz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AustinMroz/subscriptions","organizations_url":"https://api.github.com/users/AustinMroz/orgs","repos_url":"https://api.github.com/users/AustinMroz/repos","events_url":"https://api.github.com/users/AustinMroz/events{/privacy}","received_events_url":"https://api.github.com/users/AustinMroz/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":6,"created_at":"2026-03-25T20:40:33Z","updated_at":"2026-05-07T06:18:54Z","closed_at":null,"assignee":{"login":"AustinMroz","id":4284322,"node_id":"MDQ6VXNlcjQyODQzMjI=","avatar_url":"https://avatars.githubusercontent.com/u/4284322?v=4","gravatar_id":"","url":"https://api.github.com/users/AustinMroz","html_url":"https://github.com/AustinMroz","followers_url":"https://api.github.com/users/AustinMroz/followers","following_url":"https://api.github.com/users/AustinMroz/following{/other_user}","gists_url":"https://api.github.com/users/AustinMroz/gists{/gist_id}","starred_url":"https://api.github.com/users/AustinMroz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AustinMroz/subscriptions","organizations_url":"https://api.github.com/users/AustinMroz/orgs","repos_url":"https://api.github.com/users/AustinMroz/repos","events_url":"https://api.github.com/users/AustinMroz/events{/privacy}","received_events_url":"https://api.github.com/users/AustinMroz/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","type":null,"active_lock_reason":null,"draft":true,"pull_request":{"url":"https://api.github.com/repos/Comfy-Org/ComfyUI_frontend/pulls/10530","html_url":"https://github.com/Comfy-Org/ComfyUI_frontend/pull/10530","diff_url":"https://github.com/Comfy-Org/ComfyUI_frontend/pull/10530.diff","patch_url":"https://github.com/Comfy-Org/ComfyUI_frontend/pull/10530.patch","merged_at":null},"body":"## Summary\n\nLoadImage and LoadVideo previews were never promoted to parent subgraph nodes because they were missing from `CANVAS_IMAGE_PREVIEW_NODE_TYPES`.\n\n## Changes\n\n- **What**: Add `LoadImage` and `LoadVideo` to `CANVAS_IMAGE_PREVIEW_NODE_TYPES` in `canvasImagePreviewTypes.ts` so `supportsVirtualCanvasImagePreview` returns `true` for them, enabling the `$$canvas-image-preview` pseudo-widget to be created and promoted on subgraph nodes.\n\n## Review Focus\n\nThe fix is a 2-line addition to the Set. The promotion/reactivity plumbing already works for these node types — they were simply missing from the allowlist. `LoadImage` writes to `nodeOutputs` (with `type: \"input\"`) via `setNodeOutputs`, which is already tracked by `usePromotedPreviews` (after #10165). `LoadVideo` follows the same upload-widget codepath.\n\nNeeds backport to `cloud/1.41` for staging release.\n\n## Test Plan\n\n- 3 new unit tests in `promotionUtils.test.ts` covering `getPromotableWidgets` and `promoteRecommendedWidgets` for LoadImage/LoadVideo\n- All 24 tests in `promotionUtils.test.ts` pass\n- All 16 tests in `usePromotedPreviews.test.ts` and `useNodeCanvasImagePreview.test.ts` pass\n\n┆Issue is synchronized with this [Notion page](https://www.notion.so/PR-10530-fix-add-LoadImage-and-LoadVideo-to-canvas-preview-node-types-32e6d73d36508128b8dbf76f401c4efb) by [Unito](https://www.unito.io)\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/Comfy-Org/ComfyUI_frontend/issues/10530/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Comfy-Org/ComfyUI_frontend/issues/10530/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/Comfy-Org/ComfyUI_frontend/issues/9551","repository_url":"https://api.github.com/repos/Comfy-Org/ComfyU